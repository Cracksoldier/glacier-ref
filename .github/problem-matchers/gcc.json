{
  "problemMatcher": [
    {
      "owner": "gcc",
      "pattern": [
        {
          "regexp": "^([^\\s:][^:]*):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(error|warning):\\s+(.*?)(?:\\s+\\[(-W[^\\]]+)\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      ]
    }
  ]
}
